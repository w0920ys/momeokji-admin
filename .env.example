# 모먹지와 같은 Supabase 프로젝트를 인증 전용으로 재사용한다.
# 실제 값은 .env.local에 넣는다(.gitignore의 *.local에 걸려 커밋되지 않음).
VITE_SUPABASE_URL=https://fnzixhpfiasjfuaeywgx.supabase.co
# publishable(anon) 키 — 클라이언트 번들에 그대로 노출돼도 안전한 종류(RLS로 보호).
VITE_SUPABASE_ANON_KEY=

# 로그인 성공 후에도 이 이메일이 아니면 즉시 로그아웃시킨다(관리자 1인 전용 게이트).
VITE_ADMIN_EMAIL=w0920ys@gmail.com
